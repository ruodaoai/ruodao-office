{
  "name": "ruodao-office",
  "private": true,
  "version": "0.1.0",
  "description": "若道办公 · 本地优先的 Windows 办公套件",
  "author": "Ruodao",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/desktop.mjs --dev",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "collab": "node server/collab.mjs",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-icon.mjs",
    "desktop": "node scripts/desktop.mjs",
    "desktop:dev": "node scripts/desktop.mjs --dev",
    "desktop:pack": "npm run icon && npm run build && node scripts/package-win.mjs --dir",
    "desktop:build": "npm run icon && npm run build && node scripts/package-win.mjs"
  },
  "dependencies": {
    "docx": "^9.1.1",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.2.3",
    "idb-keyval": "^6.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "marked": "^12.0.2",
    "morphdom": "^2.7.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "yjs": "^13.6.33",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "productName": "若道办公"
}
